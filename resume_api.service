# Systemd service file — keeps the API running after you disconnect from SSH.
# Copy to: /etc/systemd/system/resume_api.service
# Then:  sudo systemctl daemon-reload && sudo systemctl enable --now resume_api

[Unit]
Description=Resume Similarity Analyzer FastAPI
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu
EnvironmentFile=/home/ubuntu/.env
ExecStart=/home/ubuntu/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
